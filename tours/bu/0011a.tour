ones":[{"radius":177,"sweep":0.254,"start":0.318,"speak":"Continue down the mountain for the next twenty minutes.","id":"zone_00"}]},{"id":"exit_the_park","lat":35.509633081852066,"lng":-83.30669403077536,"zones":[{"radius":144,"sweep":0.435,"start":0.042,"speak":"We are now leaving the park. Watch out for people and elk.","id":"zone_00"}]},{"id":"look_for_sign","lat":35.49951489506704,"lng":-83.30158710480079,"zones":[{"radius":130,"sweep":0.143,"start":0.015,"speak":"Watch carefully for a sign on your left. It is hard to see but it will say Big Cove. That is where we turn.","id":"zone_00"}]},{"id":"left_across_bridge","lat":35.49939990724764,"lng":-83.30309629429735,"zones":[{"radius":153,"sweep":0.171,"start":-0.058,"speak":"Take a left turn and follow the road across the bridge toward Big Cove.","id":"zone_00"}]},{"id":"cross_bridge_then_right","lat":35.49877086736255,"lng":-83.29988837231554,"zones":[{"radius":111,"sweep":0.159,"start":0.318,"speak":"After crossing the bridge, turn right on Big Cove Road.","id":"zone_00"}]},{"id":"left_at_t","lat":35.49880575292313,"lng":-83.30628097057685,"zones":[{"radius":169,"sweep":0.156,"start":-0.09,"speak":"At the T intersection, turn left onto Acquoni Road.","id":"zone_00"}]},{"id":"straight_through_roundabout","lat":35.484324060750964,"lng":-83.31439733505592,"zones":[{"radius":124,"sweep":0.238,"start":0.052,"speak":"Go straight through the roundabout.","id":"zone_00"}]},{"id":"past_islands_park","lat":35.47964865182032,"lng":-83.3181238185489,"zones":[{"radius":111,"sweep":0.483,"start":-0.006,"speak":"Continue past Islands Park.","id":"zone_00"}]},{"id":"right_onto_19","lat":35.47663721583121,"lng":-83.31930041264401,"zones":[{"radius":123,"sweep":0.149,"start":0.143,"speak":"At the light, turn right onto Route 19.","id":"zone_00"}]},{"id":"straight_thru_light","lat":35.47700444830579,"lng":-83.32062721341119,"zones":[{"radius":115,"sweep":0.25,"start":-0.198,"speak":"Cross the river, go through the light and straight up the hill,","id":"zone_00"}]},{"id":"straight_through_lights","lat":35.475381636999494,"lng":-83.32862556068335,"zones":[{"radius":111,"sweep":0.64,"start":-0.163,"speak":"Continue throuogh the lights, straight on 19.","id":"zone_00"}]},{"id":"straight_past_bridge","lat":35.46053620753663,"lng":-83.35854292004572,"zones":[{"radius":111,"sweep":0.159,"start":0.318,"speak":"Continue straight, go past the bridge.","id":"zone_00"}]},{"id":"straight_past_bridge_0","lat":35.4589988779859,"lng":-83.35805654439811,"zones":[{"radius":111,"sweep":0.501,"start":-0.024,"speak":"Continue straight, go past the bridge.","id":"zone_00"}]},{"id":"straight_past_bridge_whittier","lat":35.44720054077349,"lng":-83.38071584812043,"zones":[{"radius":111,"sweep":0.655,"start":-0.177,"speak":"Continue straight, go past the bridge into Whittier.","id":"zone_00"}]},{"id":"straight_past_bridge_1","lat":35.452941659203375,"lng":-83.391113877791,"zones":[{"radius":111,"sweep":0.85,"start":-0.373,"speak":"Continue straight, go past the bridge.","id":"zone_00"}]},{"id":"straight_past_rr_bridge","lat":35.44866861885834,"lng":-83.40147256852562,"zones":[{"radius":314,"sweep":0.402,"start":0.075,"speak":"Continue past the ancient Railroad bridge.","id":"zone_00"}]},{"id":"prepare_to_turn","lat":35.44256224165329,"lng":-83.40044975533148,"zones":[{"radius":332,"sweep":0.506,"start":-0.029,"speak":"Prepare to stop at the giddoo wah mound on your left","id":"zone_00"}]},{"id":"park","lat":35.440779207124834,"lng":-83.40071439820805,"zones":[{"radius":111,"speak":"enter the grounds. Park anywhere. But never set foot on the Mound.","id":"zone_00"}]},{"id":"left_on_the_road","lat":35.44343539684524,"lng":-83.40487003316868,"zones":[{"radius":551,"sweep":0.269,"start":-0.25,"speak":"Get back on Ela Road, and continue left","id":"zone_00"}]},{"id":"cross_the_tracks","lat":35.435080275855356,"lng":-83.4127593060248,"zones":[{"radius":202,"sweep":0.531,"start":-0.053,"speak":"Cross the tracks","id":"zone_00"}]},{"id":"left_after_bridge","lat":35.43173493335097,"lng":-83.41405391650825,"zones":[{"radius":309,"sweep":0.335,"start":0.053,"speak":"turn left immediately after crossing the river","id":"zone_00"}]},{"id":"straight_after_stop","lat":35.432165807193684,"lng":-83.3999347656345,"zones":[{"radius":318,"sweep":0.462,"start":0.318,"speak":"After the stop sign, continue straight on old Bryson City Road.","id":"zone_00"}]},{"id":"look_for_bridge","lat":35.43581999771826,"lng":-83.38932037136601,"zones":[{"radius":574,"sweep":0.381,"start":0.318,"speak":"look carefully for a small bridge on the right","id":"zone_00"}]},{"id":"right_bridge_left","lat":35.43656589333233,"lng":-83.38354110413547,"zones":[{"radius":403,"sweep":0.391,"start":0.318,"speak":"Turn right, cross the bridge then turn left right away.","id":"zone_00"}]},{"id":"left","lat":35.4346486956589,"lng":-83.38241100225333,"zones":[{"radius":114,"sweep":0.362,"start":0.115,"speak":"turn left to stay on old bryson city road","id":"zone_00"}]},{"id":"slow","lat":35.43499834000794,"lng":-83.37897777471427,"zones":[{"radius":139,"sweep":0.28,"start":0.198,"speak":"Slow down for these tight curves.","id":"zone_00"}]},{"id":"left_under_bridge","lat":35.430871816519875,"lng":-83.36181163701896,"zones":[{"radius":215,"sweep":0.234,"start":0.318,"speak":"Turn left, under the highway bridge.","id":"zone_00"}]},{"id":"right_into_whittier","lat":35.434432349160836,"lng":-83.3605599412249,"zones":[{"radius":213,"sweep":0.236,"start":-0.456,"speak":"Turn right into the town of whittier.","id":"zone_00"}]}]}
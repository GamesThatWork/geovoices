{"schema":"Open Geotour","version":1.1600000000000001,"id":"Cherokee","agent":"cherokee editor","attribution":"c.2024 Museum of the Cherokee People","author":"D Jacobson","url":null,"theme":null,"lat":35.59455421995878,"lng":-83.40935544819946,"zoom":17,"pins":[{"id":"start","lat":35.58865755800833,"lng":-83.40553379104679,"zones":[{"radius":1000000,"id":"start","text":"<p class=\"tsalagi\">ᎤᎵᎮᎵᏍᏗ</p>\n<p>Hear ancient stories and visions of tomorrow as you explore the Cherokee homeland.</p>\n<p>Share your ride with tribal storytellers. Meet heros and monsters on your sixty mile drive along mountain roads, beside swift rivers and through small towns.</p>\n<p>Whether you are a new visitor or lifelong member of the community, you will find much to discover. You'll need two or three hours.</p>\n<p>Your tour starts high in the Great Smoky Mountains, looking down over Kituwah and looking up to Kuwohi.</p>","next":"start","audio":"guide/hear-the-stories.mp3"},{"radius":286.28437569062635,"sweep":0.030055338733890102,"id":"webb_overlook_-_100_yds","slice":0.825240903829916,"speak":"Prepare to turn left to view Kuwohi Mountain from the Webb Overlook just ahead."},{"id":"Zone_1","radius":816.4051418295974,"slice":0.9199820362769866,"sweep":0.045928771400192615,"speak":"The tour begins by viewing Kuwohi Mountain from the Webb Overlook about a quarter mile away on your left","next":"Kuwohi"},{"id":"Zone_2","radius":1030.6056286913986,"slice":0.3890696182987539,"sweep":0.01,"speak":"The tour begins by viewing Mount Kuwohi from the Webb Overlook about a half mile away on your right."},{"id":"Zone_3","radius":7381.415400068169,"slice":0.33378598191120823,"sweep":0.14752096096753542,"speak":"We start our tour by viewing Kuwohi Mountain from the Webb Overlook, in North Carolina, about fifteen minutes away."},{"id":"Zone_4","radius":10191.544989149694,"slice":0.9389543691108042,"sweep":0.01,"speak":"Our tour starts with a view of Mount Kuwohi from the Webb Overlook, about fifteen minutes up the mountain from here."},{"id":"Zone_5","radius":300,"speak":"Prepare to pull off on the right at the Webb Overlook just ahead.","slice":0.34654414436456904,"sweep":0.03460702541826241},{"id":"Zone_6","radius":79.57240649379592,"speak":"Pull off now into the Overlook to start the tour with a view of Kuwohi Mountain. Look at all the mountains and valleys. Park the car and look around.","slice":-0.13709636657379282,"sweep":0.3839684757268689},{"id":"Leaving_Webb_Overlook","radius":33.34746510651121,"speak":"Leave the overlook and turn right to follow our tour down the mountain.","exit":true,"slice":-0.1925585959039861,"sweep":0.4717802506853931,"next":"webb_overlook"},{"id":"Zone_8","radius":326.9471746189824,"slice":0.34168506962868556,"sweep":0.03376498860624314,"exit":true,"speak":"Whoops. It looks like you are going the wrong way. To follow our tour, find a safe place to turn around and drive down the mountain. If you have already viewed Mount Kuwohi from the overlook, drive past it now."},{"id":"Zone_9","radius":13546.273697926224,"slice":0.8974386617938123,"sweep":0.01,"audio":"guide/this-is-a-gps-tour.mp3"},{"id":"Zone_11","radius":13958.090549105751,"slice":0.37777418545126995,"sweep":0.07088407870750174,"audio":"guide/this-is-a-gps-tour.mp3"}]},{"id":"first_fire_intro","lat":35.599892608056436,"lng":-83.4130028525119,"zones":[{"radius":370.37680933050933,"sweep":0.0980397350134172,"audio":"guide/first-fire.mp3","id":"first_fire","slice":0.3302548595543949,"exit":true,"next":"first_fire"}]},{"id":"kuwohi_intro","lat":35.589002062758496,"lng":-83.39776542475275,"zones":[{"radius":639.6007808751987,"sweep":0.09382547512110878,"audio":"guide/kawahi.mp3","id":"kuwohi_1","slice":0.5252824821499863,"next":"first_fire_intro"}]},{"id":"selu_and_kanate_intro","lat":35.436717046664796,"lng":-83.36988791906764,"zones":[{"radius":99.64598630880924,"audio":"guide/selu-kanati.mp3","id":"selu_and_kanate","slice":0.4754607585968174,"sweep":0.266733772515824,"next":"left_under_bridge"}]},{"id":"ballgame_of_birds_and_animals","lat":35.46671555271686,"lng":-83.3541909325677,"zones":[{"radius":112.3268060518863,"sweep":0.22570922914719227,"audio":"story/ballgame-of-birds-and-animals.mp3","id":"ballgame_of_birds_and_animals","slice":0.08786291933336127,"next":"straight_past_bridge_0"}]},{"id":"first_fire","lat":35.59962128408788,"lng":-83.40768322353665,"zones":[{"radius":177.63643994789527,"sweep":0.2523063774661564,"audio":"story/first-fire-story.mp3","id":"first_fire","slice":0.32038711694281324,"next":"forever_boy"}]},{"id":"forever_boy","lat":35.59232659404885,"lng":-83.3820173416971,"zones":[{"radius":389.6997330288015,"audio":"story/forever-boy.mp3","id":"the_first_fire","slice":0.40860142707182573,"sweep":0.10857402081435497,"next":"Rabbit_and_Possum"}]},{"id":"kanati","lat":35.438456417120854,"lng":-83.35528417702807,"zones":[{"radius":59.92152274742658,"audio":"story/kanati.mp3","id":"kanati","slice":0.287122143205102,"sweep":0.45060095509634734,"next":"bear_left"}]},{"id":"selu","lat":35.44417980251836,"lng":-83.29877945743323,"zones":[{"radius":231,"audio":"story/selu.mp3","id":"selu","slice":0.40383210888518484,"sweep":0.33350918617594194,"next":"right_at_y"}]},{"id":"spear_finger","lat":35.512403240049835,"lng":-83.15883519121465,"zones":[{"radius":177.2482230279906,"sweep":0.20915292951602485,"audio":"story/spearfinger.mp3","id":"spearfinger","slice":0.672664208427068,"next":"thomas_divide_overlook"}]},{"id":"kituwah_mound","lat":35.43735482721607,"lng":-83.39921236156898,"zones":[{"radius":453.84123047056823,"id":"zone_00","audio":"guide/kituwah.mp3","slice":0.3882336048021733,"sweep":0.09973155967349982},{"id":"Zone_1","radius":504.4922195582805,"speak":"Turn left on Eela Road","slice":0.41806027879736496,"sweep":0.027890954179956018,"exit":true}]},{"id":"socco_falls","lat":35.492784497500196,"lng":-83.16964566795265,"zones":[{"radius":46.82654953451806,"sweep":0.19712658429299793,"speak":"Pull off the road and enjoy the Falls.","id":"zone_00","slice":0.3724757337946517},{"id":"Zone_1","radius":351.96968994697045,"slice":0.48086085523589256,"sweep":0.0802000533222995,"speak":"We are approaching Soco Falls. Be prepared to pull over to view the Falls before we continue our climb up Soco Gap."},{"id":"Zone_2","radius":128.91094817676594,"slice":0.3841182337337817,"sweep":0.21547517938863528,"speak":"The Falls are ahead in yiour righ. The parking area is small and unpaved and unmarked. Be very careful."},{"id":"Zone_3","radius":34.72710636343893,"audio":"guide/soco-falls.mp3"},{"id":"Zone_4","radius":30,"exit":true,"speak":"Be careful as you get back on the road and head further up the mountain.","slice":-0.07814427485299241,"sweep":0.4683642428941801,"next":"pass"},{"id":"Zone_5","radius":52.78335830617712,"speak":"Wrong Way. We must go just a little further up Soco Gap, Please turn around when it is safe.","exit":true,"slice":0.40274751260417124,"sweep":0.10987439150875256}]},{"id":"museum_of_the_cherokee","lat":35.4846219725705,"lng":-83.31650888280903,"zones":[{"radius":140.98413849876354,"sweep":0.0696575283069955,"speak":"The Museum is ahead on the right - on the other side of the traffic light. Park your car. Turn right here and then pull off the road into the Museum's parking lot.","id":"zone_00","slice":0.04193628979922287},{"id":"Zone_1","radius":94.34563361394055,"speak":"enter the parking lot.","slice":0.0859121311881147,"sweep":0.28729898415034655},{"id":"Zone_2","radius":60.75158863087908,"audio":"guide/museum.mp3","next":"END"},{"id":"Zone_3","radius":364.5586169529023,"speak":"Prepare to stop at the Museum of the Cherokee People.","slice":0.13899968516856326,"sweep":0.08455445663576416},{"id":"Zone_4","radius":240.8721390548095,"speak":"The museum is the last stop on our tour. It is up ahead on our right, where you see the huge carving of Sequoya.","slice":0.10777658787288819,"sweep":0.06356045000100646}]},{"id":"webb_overlook","lat":35.588061781651305,"lng":-83.4064599037629,"zones":[{"radius":139.03807007632253,"sweep":0.26745687240290233,"id":"zone_00","slice":-0.11148105588333651,"audio":"guide/welcome.mp3"},{"id":"Zone_1","radius":141.76196038353706,"speak":"Leave the overlook and turn right to follow our tour down the mountain.","exit":true,"slice":-0.14024322992508642,"sweep":0.28420381216235674,"next":"straight_down"},{"id":"Zone_2","radius":742.2421624342277,"slice":0.11722431725423332,"sweep":0.16558590456517464,"speak":"Just a bit more driving, and one more big bend."}]},{"id":"straight_down","lat":35.586107810523245,"lng":-83.40352022563425,"zones":[{"radius":177,"sweep":0.06288921865564973,"speak":"Continue down the mountain for the next twenty minutes.","id":"zone_00","slice":0.3542316940690442,"next":"kuwohi_intro"}]},{"id":"exit_the_park","lat":35.509633081852066,"lng":-83.30669403077536,"zones":[{"radius":144,"sweep":0.435,"speak":"We are now leaving the park. Watch out for people and elk.","id":"zone_00","slice":0.042,"next":"left_across_bridge"},{"id":"Zone_1","radius":675.4379686462992,"slice":0.8457741221103645,"sweep":0.057672455151428076,"speak":"Keep going straight down the hill. Do not turn here.","exit":true}]},{"id":"left_across_bridge","lat":35.49939990724764,"lng":-83.30309629429735,"zones":[{"radius":229.65089925664662,"sweep":0.06760944878620558,"speak":"Take a left turn and follow the road across the bridge toward Big Cove.","id":"zone_00","slice":0.014283393979303172,"next":"cross_bridge_then_right"},{"id":"Zone_1","radius":125.654473073134,"slice":-0.04878609794045474,"sweep":0.1510961209682189,"speak":"Turn Left"},{"id":"Zone_2","radius":440.7047505380285,"speak":"Watch carefully for a sign on your left. It is hard to see but it will say Saunooke Bridge. It leads to Big Cove. That is where we turn.","slice":0.04324829826736026,"sweep":0.041086307098444456},{"id":"Zone_4","radius":338.9251613874451,"slice":0.03428895110985003,"sweep":0.05818090965940981,"speak":"The bridge is across on the left, but there's a sign for Big Cove here on the right,"}]},{"id":"cross_bridge_then_right","lat":35.49877086736255,"lng":-83.29988837231554,"zones":[{"radius":146.22712084185113,"sweep":0.0539536831958199,"speak":"After crossing the bridge, turn right on Big Cove Road.","id":"zone_00","slice":0.38780783822565346},{"id":"Zone_1","radius":73.63982195610757,"speak":"Turn right on Big Cove Road","slice":0.27902154305456733,"sweep":0.22912541913450868},{"id":"Zone_2","radius":30,"speak":"Right turn.","slice":0.29209849269837207,"sweep":0.21090237797912556,"next":"left_at_t"}]},{"id":"left_at_t","lat":35.49880575292313,"lng":-83.30628097057685,"zones":[{"radius":131.44857092193206,"sweep":0.03510668552925369,"speak":"At the T intersection, turn left onto Acquoni Road.","id":"zone_00","slice":-0.00229382931515143},{"id":"Zone_1","radius":388.5854497650413,"slice":0.9624641393864881,"sweep":0.026700084440267467,"speak":"continue on until the road ends - -in a Tee"},{"id":"Zone_2","radius":32.23369149432018,"speak":"Left turn.","slice":0.6563638361947248,"sweep":0.569440229901246,"next":"Yellow_Hill"}]},{"id":"straight_through_roundabout","lat":35.48452771754977,"lng":-83.31443224169854,"zones":[{"radius":191,"sweep":0.11922827950081807,"speak":"Go straight through the roundabout.","id":"zone_00","slice":0.13045662736023816,"next":"past_islands_park"},{"id":"Zone_1","radius":1057.0260010144982,"slice":0.16696162523349078,"sweep":0.051785282279813584,"speak":"Keep going straight until the roundabout a mile ahead."}]},{"id":"past_islands_park","lat":35.48089450639836,"lng":-83.31722431219534,"zones":[{"radius":154.41991662868472,"sweep":0.06244172318503538,"speak":"Continue past Islands Park.","id":"zone_00","slice":0.11818995348548644,"next":"right_onto_19"}]},{"id":"right_onto_19","lat":35.47656220836694,"lng":-83.3192533489637,"zones":[{"radius":98.90142208997909,"sweep":0.11561592852057465,"speak":"At the light, turn right onto Route 19.","id":"zone_00","slice":0.1694725353732952,"next":"straight_thru_light"},{"id":"Zone_1","radius":41.66541001134675,"speak":"Right Turn","slice":0.05911651508117416,"sweep":0.3112276899883123},{"id":"Zone_2","radius":187.56537280695585,"speak":"We're coming to the end of the road. You will turn right and go back across the Oconaluftee River.","slice":0.14777492268034742,"sweep":0.1571418579027312}]},{"id":"straight_thru_light","lat":35.47713697686112,"lng":-83.32060818604079,"zones":[{"radius":138.88349109638727,"sweep":0.05369216322625345,"speak":"Cross the river, go through the light and straight up the hill,","id":"zone_00","slice":0.9140328929153512,"next":"straight_through_lights"}]},{"id":"straight_through_lights","lat":35.475381636999494,"lng":-83.32862556068335,"zones":[{"radius":111,"sweep":0.4330048305967591,"speak":"Continue through the lights, straight on 19.","id":"zone_00","slice":-0.16219662066204543,"next":"birdtown"}]},{"id":"straight_past_bridge_0","lat":35.4589988779859,"lng":-83.35805654439811,"zones":[{"radius":167.54037563921295,"sweep":0.29105568293029965,"speak":"Continue straight, go past the bridge.","id":"zone_00","slice":-0.0703691433724179,"next":"straight_past_bridge_whittier"}]},{"id":"straight_past_bridge_whittier","lat":35.447162169258796,"lng":-83.38074612043935,"zones":[{"radius":272.43815802932585,"sweep":0.22339937879432425,"speak":"Continue straight, go past the Whittier bridge. You might not even see this bridge on your left. Don't worry - just drive on through.","id":"zone_00","slice":-0.06867705435793725,"next":"straight_past_bridge_1"}]},{"id":"straight_past_bridge_1","lat":35.452941659203375,"lng":-83.391113877791,"zones":[{"radius":241.46659842618152,"sweep":0.14681005286755042,"speak":"Continue straight, go past the Hyatt Creek bridge.","id":"zone_00","slice":0.861837223069333,"next":"RR_Bridge"}]},{"id":"park","lat":35.438295133697174,"lng":-83.40140104304056,"zones":[{"radius":116.85106510298989,"sweep":0.15183739095694468,"speak":"enter the grounds. Cross the tracks. Park anywhere. But never set foot on the Mound itself.","id":"zone_00","slice":0.34310774115641174,"next":"kituwah_mound"},{"id":"Zone_1","radius":164.6269476809249,"exit":true,"slice":0.3983044946696518,"sweep":0.06492203772105351,"speak":"Get back up on the road and turn left to continue the tour.","next":"cross_the_tracks"}]},{"id":"cross_the_tracks","lat":35.433540533446205,"lng":-83.41349458680953,"zones":[{"radius":59.35871893949069,"sweep":0.4635401541192906,"speak":"Cross the tracks and then the bridge","id":"zone_00","slice":0.01378822826876197,"next":"left_after_bridge"}]},{"id":"left_after_bridge","lat":35.43099454982218,"lng":-83.41444015914932,"zones":[{"radius":191.99596826246054,"sweep":0.1102157239088298,"speak":"turn left immediately after crossing the Tuckaseegee River","id":"zone_00","slice":0.16465961828669623},{"id":"Zone_1","radius":183.59017040869426,"slice":0.7908259476056999,"sweep":0.11896777890471946,"speak":"Continue along the southern shore of the Tuckaseegee River","exit":true,"next":"3200_tract"},{"id":"Zone_2","radius":58.650166287836015,"speak":"Left turn","slice":-0.12450344967836108,"sweep":0.529462017217995}]},{"id":"straight_after_stop","lat":35.43438238409855,"lng":-83.39838981790764,"zones":[{"radius":367.36163588939195,"sweep":0.029057406332077887,"speak":"After the traffic circle, continue straight on old Bryson City Road.","id":"zone_00","slice":0.6305030815744315},{"id":"Zone_1","radius":122.41079414011625,"slice":0.5052286292538137,"sweep":0.18587304191711884,"speak":"Go right around the tiny roundabout to stay on this road, Old Bryson City Road"},{"id":"Zone_2","radius":42.426832238758685,"speak":"This road gets smaller, but we stay on it.","slice":0.3398087504680651,"sweep":0.34191284424393575},{"id":"Zone_3","radius":87.28760874215455,"speak":"Ooops - you were not supposed to turn here. Please get back on Old Bryson City Road.","slice":0.6969241887704863,"sweep":0.12848741678694675,"exit":true,"next":"right_bridge_left"},{"id":"Zone_4","radius":110.76299774115571,"exit":true,"speak":"You were not supposed to go left. Please return to follow Old Bryson City Road.","slice":0.1751651083039023,"sweep":0.10319280474448542},{"id":"Zone_5","radius":37.53775354533913,"speak":"Good work, Judy!","slice":-0.028564411231068565,"sweep":0.08623740079818343,"exit":true}]},{"id":"right_bridge_left","lat":35.43656589333233,"lng":-83.38354110413547,"zones":[{"radius":93.49869093848737,"sweep":0.08035148616608973,"speak":"Turn right to cross the bridge then turn left.","id":"zone_00","slice":0.4458276111275005,"next":"left"},{"id":"Zone_1","radius":35.70667512196503,"slice":0.36388502348201046,"sweep":0.11905668796170388,"speak":"Here is the bridge. Turn right."},{"id":"Zone_2","radius":499.8339387795866,"speak":"look carefully for a small inconspicuous bridge coming up soon on the right.","slice":0.5086059143516705,"sweep":0.021827925598130682},{"id":"Zone_3","radius":69.41529199441767,"speak":"go left across this bridge","slice":-0.07056058731948656,"sweep":0.26294242216295066},{"id":"Zone_4","radius":63.82207811782226,"slice":-0.059432140696720814,"sweep":0.219524787037347,"exit":true,"speak":"you missed the bridge. You'd better turn around. This road goes nowhere - unless you live here."},{"id":"Zone_5","radius":166.3004734916693,"slice":0.49007085278995793,"sweep":0.051251213440021474,"text":"The bridge will be coming up on your right pretty soon."}]},{"id":"left","lat":35.435261912532965,"lng":-83.3829174026687,"zones":[{"radius":128.8151492819139,"sweep":0.0861046414635062,"speak":"turn left up ahead","id":"zone_00","slice":0.2726113736815859,"next":"slow"},{"id":"Zone_1","radius":30,"speak":"Left here.","slice":0.1280725466153148,"sweep":0.35661564118196554},{"id":"Zone_2","radius":56.24289587654606,"speak":"Left to stay on Old Bryson City Road","slice":0.1799165530877378,"sweep":0.25839498488536816}]},{"id":"slow","lat":35.43445748639398,"lng":-83.37871169893334,"zones":[{"radius":139,"sweep":0.09922648734018027,"speak":"Slow down and drive carefully. these are very tight curves.","id":"zone_00","slice":0.2706913218347322,"next":"Flute"}]},{"id":"left_under_bridge","lat":35.43083379985723,"lng":-83.36148423558984,"zones":[{"radius":283.32022853375094,"sweep":0.07633167048462661,"speak":"Turn left, at the T, to approach the old town of Whittier.","id":"zone_00","slice":0.4063265811905551},{"id":"Zone_1","radius":92.49153107637571,"speak":"Turn Left and drive under the Bridge.","slice":0.39916941607567485,"sweep":0.1082776997184321,"next":"right_into_whittier"},{"id":"Zone_2","radius":30,"speak":"Left","slice":0.32800429932490127,"sweep":0.265339312059304}]},{"id":"right_into_whittier","lat":35.43497365445338,"lng":-83.36045701460534,"zones":[{"radius":216.10552929254774,"sweep":0.1125927800865811,"speak":"Turn right into the town of whittier.","id":"zone_00","slice":0.6082372249295247},{"id":"Zone_1","radius":38.41915045626798,"slice":0.45336924918494814,"sweep":0.3289320399814996,"speak":"Turn right now","next":"revis_store"},{"id":"Zone_2","radius":85.79704044770297,"speak":"Follow the road and turn right as we pass the old Whittier Depot.","slice":0.48774739533909356,"sweep":0.2726415709860357}]},{"id":"revis_store","lat":35.43436049178932,"lng":-83.35777829805497,"zones":[{"radius":242.56075091385975,"sweep":0.06763776082269685,"speak":"Drive through the little town and turn left at Revis Store","id":"zone_00","slice":0.4359095371522481},{"id":"Zone_1","radius":56.16041441138686,"slice":0.404592121146882,"sweep":0.15079204642072572,"speak":"Turn left - here at the Revis Store.","next":"shoal_creek_road"},{"id":"Zone_2","radius":60.149896334391165,"speak":"You were supposed to turn left. Please turn around.","exit":true,"slice":0.5770869286665744,"sweep":0.3149859284860732},{"id":"Zone_3","radius":30.19109121046266,"speak":"left","slice":0.34598007822623367,"sweep":0.2481678486712441}]},{"id":"shoal_creek_road","lat":35.43817483941081,"lng":-83.35690856033125,"zones":[{"radius":256.50413063329484,"sweep":0.2522234567988232,"speak":"Turn off on Shoal Creek Road. Go right - away from the River.","id":"zone_00","slice":0.6176737245538468},{"id":"Zone_1","radius":77.39318003141398,"speak":"This is Shoal Creek Road. Turn here.","next":"kanati"},{"id":"Zone_2","radius":159.25550086564817,"exit":true,"slice":0.26361588235189554,"sweep":0.19923139287057254,"speak":"Ooops. You missed the turn to Shoal Creek Road. Turn around someplace safe."},{"id":"Zone_3","radius":345.07231719853024,"slice":0.3228722700310036,"sweep":0.10837590345312868,"speak":"Turn left up ahead at Shoal Creek Road."}]},{"id":"bear_left","lat":35.437484884803176,"lng":-83.34446182223473,"zones":[{"radius":166.2406964705856,"speak":"Bear a little left and follow the twisty road","id":"zone_00","slice":0.3278151551914875,"sweep":0.26644428319084784,"next":"Bob_Hall"}]},{"id":"birdtown","lat":35.47474404364727,"lng":-83.33809747655324,"zones":[{"radius":1035.99194267585,"audio":"guide/birdtown.mp3","id":"selu_and_kanate","slice":-0.0061843619425075436,"sweep":0.05370869167817266,"next":"ballgame_of_birds_and_animals"}]},{"id":"thomas_divide_overlook","lat":35.520617180867205,"lng":-83.24737240269003,"zones":[{"radius":1168.3239513926492,"sweep":0.026891608904155866,"speak":"We are coming up to the Thomas Divide Overlook, after a few more tight curves. You can pull off on the right.","id":"zone_00","slice":0.09076218079891868},{"id":"Zone_1","radius":30,"exit":true,"speak":"enter the parkway and continue to the right","slice":0.2379578113449126,"sweep":0.7196085012150548},{"id":"Zone_2","radius":85.33183627105689,"audio":"guide/thomas-overlook.mp3","slice":0.6881609550577107,"sweep":0.6197844367724814},{"id":"Zone_3","radius":374.4663357323512,"speak":"The overlook is up ahead on the right.","slice":0.032509234069899695,"sweep":0.11373119197352569},{"id":"Zone_4","radius":57.373019174648235,"slice":-0.37004475544014126,"sweep":0.740503030445874,"speak":"Get out of the car and take in the view"},{"id":"Zone_5","radius":187.22488912669286,"speak":"The overlook is on your right, around this last bend.","slice":-0.31324608558755784,"sweep":0.6911409405338218,"next":"Evergreen"},{"id":"Zone_6","radius":157.1971529640484,"exit":true,"speak":"It's all down hill from here.Down very steep hills.And very tight turns.For about 3 miles.Hang in there."},{"id":"Zone_7","radius":3025.9985831499644,"slice":0.015033891265649857,"sweep":0.015820536163542103,"speak":"We will pull over in about a mile and a half."}]},{"id":"new_kituwah_academy.01","lat":35.50056658701269,"lng":-83.31032913938094,"zones":[{"radius":140.0582557681895,"sweep":0.0666430470415581,"speak":"Pull off the road on the left, in the small parking area, where you can view the school.","id":"zone_00","slice":0.13394760612363465},{"id":"Zone_1","radius":78.16443431401298,"slice":0.0737741168893788,"sweep":0.06951445053733254,"speak":"After New Kituwah Academy, turn drive straight down into town."},{"id":"Zone_2","radius":133.87218261920304,"speak":"Prepare to stop at New Gidoo Wah Academy on the right.","slice":0.20764443032516616,"sweep":0.06265314295667257},{"id":"Zone_3","radius":261.6581026465403,"speak":"We are now passing the New Kituwah Academy, the immersion school where all classes are taught in the Cherokee language.","slice":0.910060981509037,"sweep":0.14445474889954693,"next":"tourism"},{"id":"Zone_4","radius":125.8381100632499,"audio":"guide/new-kituwah-academy.mp3","slice":0.29521761053632645,"sweep":0.0633052150334874},{"id":"Zone_5","radius":43.99191052635023,"speak":"After New Kituwah Academy, just drive straight down into town. ","slice":0.5637393640899726,"sweep":0.17465372855992736,"exit":true},{"id":"Zone_6","radius":99.77452851889917,"speak":"Notice the new Speakers Building to honor those who speak the Cherokee language.","slice":0.90031527814407,"sweep":0.1492774705814657}]},{"id":"left_on_411","lat":35.438792543709326,"lng":-83.32464286717257,"zones":[{"radius":219.51160511333373,"sweep":0.07140060188608714,"speak":"At the stop sign, carefully make a left turn onto Highway Four Forty One","id":"zone_00","slice":0.38501215652928156,"next":"right_behind_santa"},{"id":"Zone_1","radius":46.21826746699284,"speak":"Turn Left. Carefully.","slice":0.2765243261181992,"sweep":0.29162510070978315},{"id":"Zone_2","radius":300,"speak":"You are going the wrong way.","slice":0.5766277044951157,"sweep":0.17311238872735635}]},{"id":"right_behind_santa","lat":35.44834746059497,"lng":-83.30698013038274,"zones":[{"radius":817,"speak":"In a minute, turn right on Camp Creek Road.","id":"zone_00","slice":0.526740300031172,"sweep":0.12752620932947256},{"radius":56.17231176150089,"id":"zone_01","speak":"Turn here onto Camp Creek.","next":"left_on_old_mission"},{"id":"Zone_2","radius":393.61401301160845,"slice":0.5179897662360051,"sweep":0.17040361724072858,"speak":"Turn right up ahead on Camp Creek Road. It is tricky because the road is hidden by a billboard. And it is unmarked."},{"id":"Zone_3","radius":157.54644947695107,"speak":"But there is a turning lane, so get ready for this next right turn.","slice":0.4977378091515305,"sweep":0.18678877819796758}]},{"id":"left_on_old_mission","lat":35.44335483197887,"lng":-83.30160121520869,"zones":[{"radius":156.6265447560049,"sweep":0.18617191721928272,"speak":"Turn left into the valley. Turn left on Old Mission Road","id":"zone_00","slice":0.21921214581315887,"next":"selu"},{"id":"Zone_1","radius":40.45541385302567,"speak":"Turn left."},{"id":"Zone_2","radius":484.5593196985598,"speak":"In the valley ahead we will make a left turn.","slice":0.3045887452276245,"sweep":0.12316761664986624}]},{"id":"right_at_y","lat":35.45454303300485,"lng":-83.2831375119713,"zones":[{"radius":160.81999269912143,"sweep":0.36973832428257136,"speak":"Stay to the right at the branch up ahead.","id":"zone_00","slice":0.4586261603794098,"next":"right_at_t"}]},{"id":"right_at_t","lat":35.466653201149704,"lng":-83.27550888061525,"zones":[{"radius":72.17064851861333,"sweep":0.21180944439649407,"speak":"For the next fifteen minutes we will be climbing up through Soak-oh Gap. It will be a high twisting pass through the mountains, so drive with care.","id":"zone_00","slice":-0.04132285385165041,"exit":true,"next":"Wolfetown"},{"id":"Zone_1","radius":51.56271828621832,"speak":"Turn Right","slice":0.5826386560496093,"sweep":0.3858203342163596},{"id":"Zone_2","radius":444.05210378857646,"speak":"At the end of this road, we will make a right on Wolfetown Road.","slice":0.7130038228849447,"sweep":0.13867309873037542},{"id":"Zone_3","radius":183.53503116059906,"speak":"We will turn right and begin our climb up Soak-oh Gap.","slice":0.6684009081695437,"sweep":0.19051367120531515}]},{"id":"pass","lat":35.49432415728716,"lng":-83.16909314121462,"zones":[{"radius":133.37159390003697,"speak":"After leaving the falls, continue up Socco Pass.","id":"zone_00","slice":0.5859402813375008,"sweep":0.1893524998294345,"next":"Tecumseh"}]},{"id":"right_blue_ridge","lat":35.49515896458877,"lng":-83.15691232718109,"zones":[{"radius":276,"sweep":0.2,"speak":"Turn right to enter the Blue Ridge Parkway.","id":"zone_00","slice":0.464},{"id":"Zone_1","radius":63.61581128703194,"speak":"Turn right here.","slice":0.38142336911479996,"sweep":0.41680482539820574,"next":"left_smokies"}]},{"id":"left_smokies","lat":35.495975823473486,"lng":-83.1556069849762,"zones":[{"radius":115,"sweep":0.126,"speak":"Turn left onto the Parkway toward the Great Smoky Mountains National Park.","id":"zone_00","slice":-0.449,"next":"Blue_Ridge"}]},{"id":"straight_cherokee","lat":35.49859137405886,"lng":-83.15544129975603,"zones":[{"radius":77.56039702946809,"sweep":0.7180565074156949,"speak":"Continue straight toward the park.","id":"zone_00","slice":0.41589814664889024,"next":"spear_finger"}]},{"id":"caution","lat":35.51033813277777,"lng":-83.27248283244684,"zones":[{"radius":111,"sweep":0.41077872111185587,"speak":"Slow down on dangerous curves.","id":"zone_00","slice":-0.051610177147214,"next":"Schools"}]},{"id":"right_in_park","lat":35.50542941937382,"lng":-83.30090403540454,"zones":[{"radius":107,"sweep":0.1530537009115103,"speak":"Just turn left and drive straight into town. Do not cross the river again. Even if I tell you to.","id":"zone_00","slice":0.07707182982574406},{"id":"Zone_1","radius":280.1928064693884,"slice":0.08779041117049563,"sweep":0.14363045620261508,"speak":"We will leave the Blue Ridge Parkway and go left out the park and into the town of Cherokee."},{"id":"Zone_2","radius":416.0280098545745,"speak":"Follow this road straight into town. Please be certain that you do not cross the river again, even if I instruct you to do so. Sometimes I get confused here. Just stay on this road.","slice":-0.011312773181528846,"sweep":0.2970998270831211},{"id":"Zone_3","radius":62.58834885841495,"slice":0.737322389289909,"sweep":0.11192570648216396,"exit":true,"speak":"Stay on this road right into town. No matter what.","next":"new_kituwah_academy.01,MANDATORY"}]},{"id":"tourism","lat":35.49733143630206,"lng":-83.31317284873938,"zones":[{"radius":41.92785944244054,"sweep":0.4548740447893046,"id":"zone_00","slice":-0.018667038135750436,"audio":"guide/tourism.mp3","next":"museum_of_the_cherokee"}]},{"id":"Yellow_Hill","lat":35.49611566274135,"lng":-83.30847687502684,"tags":[],"zones":[{"id":"Zone_0","radius":300,"speak":"Keep going - through the small community of Yellow Hill","next":"straight_through_roundabout","slice":0.08643942952167755,"sweep":0.13491774263649292}]},{"id":"Enter_the_Mound","lat":35.43923205872116,"lng":-83.40569810416969,"tags":[],"zones":[{"id":"Zone_0","radius":327.118915502722,"slice":0.007932601921423421,"sweep":0.03731059723911056,"speak":"Turn Left right here","next":"park"},{"id":"Zone_1","radius":181.58761533409282,"audio":"guide/leaving-kituwah.mp3","slice":-0.011908557089631122,"sweep":0.04064658600739905},{"id":"Zone_2","radius":647.5970165363564,"speak":"The Kituwah Mound is up ahead. There is a small sign.","slice":0.04075108113209763,"sweep":0.08058960778096491},{"id":"Zone_3","radius":807.3325915511218,"speak":"Prepare to stop at the Kituwah mound on your left","slice":0.061005397069094025,"sweep":0.06242254018989518}]},{"id":"Flute","lat":35.43454784770993,"lng":-83.37450635061228,"tags":[],"zones":[{"id":"Zone_0","radius":126.96796175677136,"slice":0.3178729561577848,"sweep":0.31282431521655174,"audio":"music/flute.mp3","next":"selu_and_kanate_intro"}]},{"id":"Ranger_Station","lat":35.514848316021656,"lng":-83.30684995336925,"tags":[],"zones":[{"id":"Zone_0","radius":219.48088980375056,"speak":"The Park Ranger Station is not part of our tour. But they have clean public bathrooms, so you might want to stop.","slice":-0.007272289439577917,"sweep":0.49656402656524734,"next":"exit_the_park"}]},{"id":"Wolfetown","lat":35.46725383866971,"lng":-83.26587161128484,"tags":[],"zones":[{"id":"Zone_0","radius":300,"audio":"guide/soco-gap.mp3","slice":0.3423163108898109,"sweep":0.2570702165154428,"next":"Chunkey"}]},{"id":"Evergreen","lat":35.517819758356936,"lng":-83.25097904317875,"tags":[],"zones":[{"id":"Zone_0","radius":48.65134152341936,"audio":"story/evergreen.mp3","slice":-0.2746921247310701,"sweep":0.6957544992768161,"next":"caution"}]},{"id":"Tecumseh","lat":35.49570463887305,"lng":-83.16935067520492,"tags":[],"zones":[{"id":"Zone_0","radius":257.7527959730129,"audio":"guide/tecumseh.mp3","slice":0.6199141136158046,"sweep":0.23780404640753935,"next":"right_blue_ridge"}]},{"id":"Friendship_Dance","lat":35.479514064116,"lng":-83.2015920845218,"tags":[],"zones":[{"id":"Zone_0","radius":1572.44136916967,"audio":"music/friendship-dance-6.mp3","slice":0.5404731043612422,"sweep":0.04697058208219741,"next":"Dance_1"}]},{"id":"Blue_Ridge","lat":35.49720483598373,"lng":-83.15553830497952,"tags":[],"zones":[{"id":"Zone_0","radius":106.055517452758,"audio":"guide/blue-ridge-gsm.mp3","slice":0.5101938569310303,"sweep":0.48354339012430686,"next":"straight_cherokee"}]},{"id":"Chunkey","lat":35.46993919932108,"lng":-83.22927798089782,"tags":[],"zones":[{"id":"Zone_0","radius":1385.914525292217,"audio":"story/chunkey.mp3","slice":0.5419222459959256,"sweep":0.13788233442501516,"next":"Friendship_Dance"}]},{"id":"Dance_1","lat":35.48699422352908,"lng":-83.19167838039816,"tags":[],"zones":[{"id":"Zone_0","radius":214.5165763934838,"audio":"guide/spanish-encounter.mp3","slice":0.43140668043550134,"sweep":0.2391167120567278,"next":"socco_falls"}]},{"id":"Roundabout_Exit","lat":35.48385482265256,"lng":-83.3144971299761,"tags":[],"zones":[{"id":"Zone_0","radius":64.10328483191375,"speak":"Exit now","slice":0.2172489094148414,"sweep":0.11832268710890574}]},{"id":"RR_Bridge","lat":35.44921858120138,"lng":-83.40159578155321,"tags":[],"zones":[{"id":"Zone_0","radius":184.9916943214752,"slice":0.07525213686456717,"sweep":0.17295897809499364,"speak":"Continue past the ancient iron railroad bridge, across the river up ahead.","next":"Enter_the_Mound"}]},{"id":"3200_tract","lat":35.426590291453955,"lng":-83.40895738966213,"tags":[],"zones":[{"id":"Zone_0","radius":129.57245387567096,"audio":"guide/3200-acre-tract.mp3","next":"straight_after_stop","slice":0.39366334330952113,"sweep":0.2162337580473006}]},{"id":"Bob_Hall","lat":35.441053505393064,"lng":-83.33868415897147,"tags":[],"zones":[{"id":"Zone_0","radius":84.00321527271993,"speak":"stay to the right","slice":0.4419084393964908,"sweep":0.1963036901890176,"next":"left_on_411"}]},{"id":"GSMNP","lat":35.51030068156009,"lng":-83.29623707747419,"tags":[],"zones":[{"id":"Zone_0","radius":300,"audio":"guide/smoky-mountains-park.mp3","next":"right_in_park","slice":-0.016364545329470348,"sweep":0.24569820052438615}]},{"id":"END","lat":35.48438551166424,"lng":-83.31779355869766,"tags":[],"zones":[]},{"id":"Detour_(April_23)","lat":35.483335907912476,"lng":-83.31512403448872,"tags":[],"zones":[{"id":"Zone_0","radius":192.5182765418193,"slice":0.15018999256915716,"sweep":0.06173080384016784,"speak":"Continue 180 degrees through the roundabout so that you stay on Acquino road."}]},{"id":"Into_Town","lat":35.4928631508056,"lng":-83.31401796428695,"tags":[],"zones":[{"id":"Zone_0","radius":104.44190333475228,"speak":"continue straight into the town of Cherokee"}]},{"id":"Schools","lat":35.513061051893416,"lng":-83.29413384433367,"tags":[],"zones":[{"id":"Zone_0","radius":30.651592769614606,"audio":"guide/education.mp3","slice":-0.3702179326797849,"sweep":0.8302060933191965,"next":"GSMNP"},{"id":"Zone_1","radius":64.56497064770726,"slice":0.03493713825301731,"sweep":0.23501343227673,"speak":"Pull into the parking area where you can ge a view.Try to find a gap in the trees so you can see the structures below us."},{"id":"Zone_2","radius":130.52751027167287,"text":" ","speak":"There is a pull off on the right. Please pull off the road.","slice":0.10457340130247283,"sweep":0.12222936503550641},{"id":"Zone_3","radius":300,"exit":true,"speak":"Prepare to park at the Overlook that is coming up on your right.","slice":0.04882145140565369,"sweep":0.15012882557233256}]},{"id":"Rabbit_and_Possum","lat":35.548770681669865,"lng":-83.3096004616537,"tags":[],"zones":[{"id":"Zone_0","radius":4531.619025897169,"audio":"story/rabbit-and-possum.mp3","slice":0.3778276382947587,"sweep":0.03288748062590099,"next":"Ranger_Station"}]},{"id":"Kuwohi","lat":35.590338417950804,"lng":-83.40082168448134,"tags":[],"zones":[{"id":"Zone_0","radius":308.85875448557937,"audio":"story/clan-mothers.mp3","slice":0.8596467352324708,"sweep":0.10916356148142686,"next":"first_fire_intro"}]}],"credits":[{"head":"Museum of the Cherokee People"},{"role":"Storyteller","name":"Freeman Owle"},{"role":"Storyteller","name":"Kathi Littlejohn"},{"role":"Story, Song, Flute","name":"Jarrett Wildcatt"},{"role":"Guide, Storyteller","name":"Nola Teesatuskie"},{"role":"Digital Weaver","name":"Christy Long"},{"role":"Classic Weaver","name":"Eva Wolfe"},{"role":"Audio Engineer","name":"Christopher McCoy"},{"role":"Writer, Producer","name":"Shennelle Feather"},{"role":"Executive Producer","name":"Dakota Brown"}],"interrupted":1711110535131,"timestamp":1711110535131,"next":"straight_past_bridge_0"}
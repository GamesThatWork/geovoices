            "zones": [
                {
                    "radius": 1000000,
                    "id": "start",
                    "text": "<p class=\"tsalagi\">ᎤᎵᎮᎵᏍᏗ</p>\n<p>Hear ancient stories and visions of tomorrow as you explore the Cherokee homeland.</p>\n<p>Share your ride with tribal storytellers. Meet heros and monsters on your sixty mile drive along mountain roads, beside swift rivers and through small towns.</p>\n<p>Whether you are a new visitor or lifelong member of the community, you will find much to discover. You'll need two or three hours.</p>\n<p>Your tour starts high in the Great Smoky Mountains, looking down over Kituwah and looking up to Kuwohi.</p>",
                    "next": "start",
                    "audio": "guide/hear-the-stories.mp3"
                },
                {
                    "radius": 286.28437569062635,
                    "sweep": 0.030055338733890102,
                    "id": "webb_overlook_-_100_yds",
                    "slice": 0.825240903829916,
                    "speak": "Prepare to turn left to view Kuwohi Mountain from the Webb Overlook just ahead."
                },
                {
                    "id": "Zone_1",
                    "radius": 624.4111540369398,
                    "slice": 0.9080334783561883,
                    "sweep": 0.041822444884635844,
                    "speak": "The tour begins by viewing Kuwohi Mountain from the Webb Overlook about a quarter mile away on your left",
                    "next": "View_Kuwohi"
                },
                {
                    "id": "Zone_2",
                    "radius": 1030.6056286913986,
                    "slice": 0.3890696182987539,
                    "sweep": 0.01,
                    "speak": "The tour begins by viewing Mount Kuwohi from the Webb Overlook about a half mile away on your right."
                },
                {
                    "id": "Zone_3",
                    "radius": 7381.415400068169,
                    "slice": 0.33378598191120823,
                    "sweep": 0.14752096096753542,
                    "speak": "We start our tour by viewing Kuwohi Mountain from the Webb Overlook, in North Carolina, about fifteen minutes away."
                },
                {
                    "id": "Zone_4",
                    "radius": 10686.159876661259,
                    "slice": 0.938728132364298,
                    "sweep": 0.01,
                    "speak": "Our tour starts with a view of Mount Kuwohi from the Webb Overlook, about fifteen minutes up the mountain from here."
                },
                {
                    "id": "Zone_5",
                    "radius": 300,
                    "speak": "Prepare to pull off on the right at the Webb Overlook just ahead.",
                    "slice": 0.34654414436456904,
                    "sweep": 0.03460702541826241
                },
                {
                    "id": "Zone_6",
                    "radius": 79.57240649379592,
                    "speak": "Pull off now into the Overlook to start the tour with a view of Kuwohi Mountain. Look at all the mountains and valleys. Park the car and look around.",
                    "slice": -0.2341261900164806,
                    "sweep": 0.5842505309197447,
                    "next": "View_Kuwohi"
                },
                {
                    "id": "Leaving_Webb_Overlook",
                    "radius": 33.34746510651121,
                    "speak": "Leave the overlook and turn right to follow our tour down the mountain.",
                    "exit": true,
                    "slice": -0.2141452733755601,
                    "sweep": 0.5044594867831587,
                    "next": "straight_down"
                },
                {
                    "id": "Zone_8",
                    "radius": 326.9471746189824,
                    "slice": 0.34168506962868556,
                    "sweep": 0.03376498860624314,
                    "exit": true,
                    "speak": "Whoops. It looks like you are going the wrong way. To follow our tour, find a safe place to turn around and drive down the mountain. If you have already viewed Mount Kuwohi from the overlook, drive past it now."
